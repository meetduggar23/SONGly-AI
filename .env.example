# API configuration
# Lyrics APIs are public and don't require keys.
# Music metadata APIs (Deezer, iTunes, Last.fm) are also public for basic usage.

# Optional: Last.fm API key (free registration at last.fm)
VITE_LASTFM_API_KEY=

# AudD music recognition API key (free tier at audd.io)
# IMPORTANT: read SERVER-SIDE only — never exposed to the browser.
# The Vite dev/preview middleware injects it into requests made to
# /api/audd (see vite.config.ts). Without it, detection reports that
# recognition isn't configured. No fake/demo results are ever shown.
AUDD_API_KEY=

# Optional secondary AudD key. Tried automatically when the primary key is
# rejected by AudD (invalid/inactive token) so detection keeps working.
AUDD_API_KEY_FALLBACK=

# Optional: CORS proxy base (the app appends "/?url=<encoded-target>" to it).
# Defaults to https://corsproxy.io — set your own in production to avoid
# rate limits on the free tier. Example: VITE_API_PROXY=https://corsproxy.io
# VITE_API_PROXY=
